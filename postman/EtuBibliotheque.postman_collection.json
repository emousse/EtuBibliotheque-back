{
  "info": {
    "name": "EtuBibliotheque",
    "description": "API EtuBibliothèque.\n\nOrdre conseillé : 1. Auth > Login (enregistre le token), puis le dossier Students dans l'ordre.\nLe token est stocké dans la variable de collection `token` et envoyé automatiquement (Bearer) à toutes les requêtes qui héritent de l'authentification de la collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "login", "value": "demo", "type": "string" },
    { "key": "password", "value": "demo1234", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "studentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"Test\",\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/register",
            "description": "Crée l'agent {{login}}. Renvoie 400 s'il existe déjà (normal si vous l'avez déjà créé)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created (ou 400 si l\\'agent existe déjà)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/login",
            "description": "Authentifie l'agent et enregistre le JWT dans la variable de collection `token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.test('Un token est renvoyé', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.{{$timestamp}}@example.com\",\n  \"birthDate\": \"2000-12-10\"\n}"
            },
            "url": "{{baseUrl}}/api/students",
            "description": "Crée un étudiant et enregistre son id dans `studentId`. L'email utilise {{$timestamp}} pour rester unique à chaque exécution."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('studentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/students"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('La réponse est une liste', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get student",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Bon étudiant', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('studentId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update student",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"King\",\n  \"email\": \"ada.king.{{$timestamp}}@example.com\",\n  \"birthDate\": \"2000-12-10\"\n}"
            },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Nom modifié', () => pm.expect(pm.response.json().lastName).to.eql('King'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete student",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "List students without token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/students",
            "description": "Vérifie que la route est protégée : sans token, l'API répond 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
